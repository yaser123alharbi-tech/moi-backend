# PostgreSQL connection (use the connection string your host gives you)
DATABASE_URL=postgres://user:password@host:5432/moi_db

# Set to "true" only if your provider requires SSL (Supabase/Neon/Render usually do)
DATABASE_SSL=true

# Secret used to sign JWT tokens - generate a long random string for production
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your site's URL)
CORS_ORIGIN=http://localhost:3000,https://your-site-domain.com
